# NodeSend relay — required and optional environment.
# Values are never committed. In the hosted deployment these live in Coolify.
# Nothing here may be exposed to the browser: no VITE_* prefix, ever.

# --- mandatory -------------------------------------------------------------
# Shared relay key for the server-to-server surfaces only: /send, /rocketchat,
# and the generic /quota adapter. AI endpoints are authenticated by the signed-in
# BridgeMind session instead, so this key is not what guards the AI path.
BRIDGE_API_KEY=

# RSA private key used to decrypt provider API keys that arrive from the browser
# as RSA-OAEP/SHA-256 ciphertext. Base64 of the PEM, or the PEM itself with
# literal \n separators. Exactly one of the two is set.
NODESEND_PRIVATE_KEY_B64=
NODESEND_PRIVATE_KEY_PEM=

# --- session + quota authority (defaults match the BridgeMind instance) ------
# NCB is one authority with two jobs: /auth/get-session proves WHO the caller is,
# and its own ai_quota_config / ai_quota_user_override / ai_quota_usage rows hold
# the per-user monthly counter. NodeSend reaches those tables through the same
# /data/ API BridgeMind's client uses, always with the caller's own session bearer.
# There is no quota database URL, no second database and no service credential on
# this path — do not add one, and never give any of these a VITE_* prefix.
NCB_PROXY_BASE=https://rmvzorxcl35mttidiexhtp5g2m0hpsqo.lambda-url.us-east-2.on.aws
NCB_INSTANCE=55954_bridgemind

# --- optional --------------------------------------------------------------
PORT=3001
# Reject legacy plaintext provider keys by leaving this false (the default).
ALLOW_PLAINTEXT_AI_KEYS=false
# Upstream provider timeout, and the NCB timeout that covers both the session
# lookup and every ai_quota_* read and write.
NODESEND_UPSTREAM_TIMEOUT_MS=90000
NODESEND_NCB_TIMEOUT_MS=8000
# Comma-separated Alibaba hosts allowed for the relay to talk to.
ALIBABA_ALLOWED_HOSTS=

# --- separate, unrelated server-account surface ----------------------------
# Rocket.Chat webhook, SMTP is supplied per request, and the optional generic
# /quota adapter for a trusted server-account service. None of these is the
# per-user AI quota.
ROCKETCHAT_WEBHOOK_URL=
NODESEND_QUOTA_URL=
NODESEND_QUOTA_BEARER_TOKEN=
NODESEND_QUOTA_TIMEOUT_MS=5000

# --- TRICKSTER decision-engine gateway (server-side only) -------------------
# BridgeMind's frontend is a static Vite build, and the two TRICKSTER services send
# no CORS headers and answer a preflight with 405, so the browser cannot reach them
# directly. NodeSend exposes /trickster/{bid,play}/health and
# /trickster/{bid,play}/suggest-{bid,card}, guarded by the same BridgeMind Bearer
# session as /ai/chat (never by BRIDGE_API_KEY), forwarding the JSON body unchanged
# and preserving the upstream status. No bid or card is decided here and there is no
# AI fallback. Defaults are the production hosts, so this block can be left unset.
# Never give any of these a VITE_* prefix: a VITE_ value ships to every visitor.
TRICKSTER_BID_URL=https://bid.bridgemind.app
TRICKSTER_PLAY_URL=https://play.bridgemind.app
# Per-request upstream timeout in ms, bounded to 500-60000 (default 15000).
TRICKSTER_TIMEOUT_MS=15000
# RESERVED, not wired by the services yet. When TRICKSTER gains authentication this
# is the only place it is read; it is sent server-to-server as `x-api-key` and is
# never echoed in a response, a log line or a browser-visible variable. Leave empty.
TRICKSTER_API_KEY=
