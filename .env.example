# NodeSend relay — required and optional environment.
# Values are never committed. In the hosted deployment these live in Coolify.
# Nothing here may be exposed to the browser: no VITE_* prefix, ever.

# --- mandatory -------------------------------------------------------------
# Shared relay key for the server-to-server surfaces only: /send, /rocketchat,
# and the generic /quota adapter. AI endpoints are authenticated by the signed-in
# BridgeMind session instead, so this key is not what guards the AI path.
BRIDGE_API_KEY=

# RSA private key used to decrypt provider API keys that arrive from the browser
# as RSA-OAEP/SHA-256 ciphertext. Base64 of the PEM, or the PEM itself with
# literal \n separators. Exactly one of the two is set.
NODESEND_PRIVATE_KEY_B64=
NODESEND_PRIVATE_KEY_PEM=

# --- session authority (defaults match the BridgeMind instance) -------------
# NCB is the application database owner and is used here for ONE thing:
# /auth/get-session, to prove WHO the caller is and what role they hold. NodeSend
# reads and writes no NCB table and uses no /data/ route — quota included, which is
# decided by the BridgeMind quota service below. Never give any of these a VITE_*
# prefix: a VITE_ value ships to every visitor.
NCB_PROXY_BASE=https://rmvzorxcl35mttidiexhtp5g2m0hpsqo.lambda-url.us-east-2.on.aws
NCB_INSTANCE=55954_bridgemind

# --- per-user AI quota DECISION service (BridgeMind-owned; server-side only) ---
# NodeSend owns no quota data: no table names, no schema, no period arithmetic, no
# database credential, no service secret. It asks this BridgeMind-owned endpoint for
# a decision and relays it. The value is the BASE path; the relay calls
#   POST <base>/reserve    ask to spend one call (spends it if allowed)
#   GET  <base>/status     the caller's current summary, no spend
#   GET  <base>/config     admin-only configuration read
#   PUT  <base>/config     admin-only configuration write (body forwarded as-is)
# Each call carries only `Authorization: Bearer <the validated session token of the
# caller>` — never a user_id, never a key of its own. The service is responsible for
# config, overrides, usage, safe reservation and admin validation, and answers:
#   {"allowed":true,"enabled":true,"unlimited":false,"used":12,"limit":100,
#    "remaining":88,"period":"2026-10","resetAt":"2026-11-01T00:00:00Z"}
# Anything else (non-JSON, no boolean "allowed", 4xx/5xx, timeout) fails CLOSED:
# GET /ai/quota and GET/PUT /ai/quota/config answer 503 and POST /ai/chat returns
# 429 or 503 without contacting the provider. https is required (loopback http is
# accepted only for a local test harness), and credentials in the URL are refused.
#
# POST /reserve may additionally carry the caller's logical-decision key, in the header
#   x-ai-decision-key: <logical decision key>
# alongside the Authorization bearer above. It is a BILLING label and nothing more: never
# authentication, never identity, never an owner assertion. Who a reservation belongs to
# comes only from the validated session bearer, and the service scopes the key to that
# user and the current period itself, so a key cannot cross accounts. A reservation sent
# without it is charged as a new decision, and NodeSend never invents a key of its own.
#
# NOTE: this endpoint exists in the BridgeMind application code but must be deployed as a
# reachable server service before it can answer. Leave BRIDGEMIND_QUOTA_URL unset until
# that service is deployed; quota-dependent routes fail closed while it is unset.
# The lookup shares NODESEND_QUOTA_TIMEOUT_MS with the generic adapter below.
BRIDGEMIND_QUOTA_URL=

# --- optional --------------------------------------------------------------
PORT=3001
# Reject legacy plaintext provider keys by leaving this false (the default).
ALLOW_PLAINTEXT_AI_KEYS=false
# Upstream provider timeout, and the NCB timeout for the session lookup.
NODESEND_UPSTREAM_TIMEOUT_MS=90000
NODESEND_NCB_TIMEOUT_MS=8000
# Comma-separated Alibaba hosts allowed for the relay to talk to.
ALIBABA_ALLOWED_HOSTS=

# --- separate, unrelated server-account surface ----------------------------
# Rocket.Chat webhook, SMTP is supplied per request, and the optional generic
# /quota adapter for a trusted server-account service. None of these is the
# per-user AI quota, and NODESEND_QUOTA_URL is NOT the flag that reports whether
# per-user quota works — that is BRIDGEMIND_QUOTA_URL above.
# NODESEND_QUOTA_TIMEOUT_MS is the quota lookup timeout for BOTH quota surfaces:
# this generic server-account adapter and the per-user decision service above.
ROCKETCHAT_WEBHOOK_URL=
NODESEND_QUOTA_URL=
NODESEND_QUOTA_BEARER_TOKEN=
NODESEND_QUOTA_TIMEOUT_MS=5000

# --- TRICKSTER decision-engine gateway (server-side only) -------------------
# BridgeMind's frontend is a static Vite build, and the two TRICKSTER services send
# no CORS headers and answer a preflight with 405, so the browser cannot reach them
# directly. NodeSend exposes /trickster/{bid,play}/health and
# /trickster/{bid,play}/suggest-{bid,card}, guarded by the same BridgeMind Bearer
# session as /ai/chat (never by BRIDGE_API_KEY), forwarding the JSON body unchanged
# and preserving the upstream status. No bid or card is decided here and there is no
# AI fallback. Defaults are the production hosts, so this block can be left unset.
# Never give any of these a VITE_* prefix: a VITE_ value ships to every visitor.
TRICKSTER_BID_URL=https://bid.bridgemind.app
TRICKSTER_PLAY_URL=https://play.bridgemind.app
# Per-request upstream timeout in ms, bounded to 500-60000 (default 15000).
TRICKSTER_TIMEOUT_MS=15000
# RESERVED, not wired by the services yet. When TRICKSTER gains authentication this
# is the only place it is read; it is sent server-to-server as `x-api-key` and is
# never echoed in a response, a log line or a browser-visible variable. Leave empty.
TRICKSTER_API_KEY=
