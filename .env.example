# NodeSend relay — required and optional environment.
# Values are never committed. In the hosted deployment these live in Coolify.
# Nothing here may be exposed to the browser: no VITE_* prefix, ever.

# --- mandatory -------------------------------------------------------------
# Shared relay key for the server-to-server surfaces only: /send, /rocketchat,
# and the generic /quota adapter. AI endpoints are authenticated by the signed-in
# BridgeMind session instead, so this key is not what guards the AI path.
BRIDGE_API_KEY=

# RSA private key used to decrypt provider API keys that arrive from the browser
# as RSA-OAEP/SHA-256 ciphertext. Base64 of the PEM, or the PEM itself with
# literal \n separators. Exactly one of the two is set.
NODESEND_PRIVATE_KEY_B64=
NODESEND_PRIVATE_KEY_PEM=

# --- session authority AND quota storage (defaults match the BridgeMind instance) --
# NCB is the application database owner and is used here for two things:
#   /auth/get-session        to prove WHO the caller is and what role they hold
#   /data/{read,create,update,delete}/<table>   the per-user AI quota counter
# Both go through the SAME call and the SAME credential: the caller's own session bearer.
# There is no quota service URL to configure, no quota service secret, and no second
# backend hop — NodeSend is the only quota backend and BridgeMind is a static frontend
# that talks to these routes. Never give any of these a VITE_* prefix: a VITE_ value
# ships to every visitor.
NCB_PROXY_BASE=https://rmvzorxcl35mttidiexhtp5g2m0hpsqo.lambda-url.us-east-2.on.aws
NCB_INSTANCE=55954_bridgemind

# WHICH TRANSPORT THE RELAY DIALS. `proxy` is the value above and the AWS-era protocol: the browser's
# `Authorization: Bearer <token>` forwarded to a service that held the NCB session behind it. That
# service is dead (403 on every path since 2026-11-19), so a deployment that wants working sessions
# sets `native`, and `native` means: the browser holds a NodeSend SEALED HANDLE, the relay validates
# the NCB cookie inside it, and every data call is made AS THAT PLAYER with their own cookie and NO
# Authorization header. `proxy` stays the default until the native path has been proven in
# production, which is why switching is an explicit act and not a side effect of a deploy.
# Anything other than these two words is treated as `proxy`.
NCB_TRANSPORT=proxy
# The two native families. They are SEPARATE because the vendor's are: the auth family takes the
# instance by `X-Database-Instance` header (and rejects `?Instance=`), the data family takes it by
# `?Instance=` query (and rejects `?db=`). Both are required, and both must be https, when
# NCB_TRANSPORT=native — a half-configured native deployment FAILS CLOSED with a named reason rather
# than silently falling back to the dead proxy, because a fallback of that kind turns a missing
# variable into an outage nobody can attribute.
NCB_AUTH_API_URL=https://app.nocodebackend.com/api/user-auth
NCB_DATA_API_URL=https://app.nocodebackend.com/api/data
# The Origin the relay presents to the vendor on every NCB call. The PoC that authenticated
# successfully sent `Origin: https://app.bridgemind.app`; a request with none still reaches
# credential validation (measured with an address no account owns), so this is not what unlocked the
# 403 — but it is what makes our request indistinguishable from the one that is known to work, on the
# family where the vendor decides whether to issue a session. It is a NAME, not a credential: public
# information, never read from a browser request, and a caller cannot steer it. Set it empty to send
# no Origin at all.
NCB_TRUSTED_ORIGIN=https://app.bridgemind.app

# --- per-user AI quota AUTHORITY (decided here; stored in NCB; never a browser value) --
# NodeSend resolves the configuration, the per-user limit and the usage row, keeps the
# period arithmetic, holds the reservation ledger, and writes the counter itself — reading
# and writing these four NCB tables with the caller's bearer. Routes:
#   POST /ai/chat            reserves one call BEFORE the provider is contacted
#   GET  /ai/quota           the caller's current summary, no spend
#   GET  /ai/quota/config    admin-only configuration read  (session + admin role)
#   PUT  /ai/quota/config    admin-only configuration write (session + admin role)
#   GET  /ai/quota/status    admin-only view of one TARGET user's quota (session + admin)
#   PUT  /ai/quota/user      admin-only per-user limit write   (session + admin role)
# Defaults match the tables that exist in NCB today; the names are configurable only so a
# rename is not a code change. Table names are not secrets. Every quota read and write is
# made with the caller's own validated session bearer: that proves the identity the quota
# decision is taken for, and nothing more. Normal quota operations are addressed by that
# validated user id — NodeSend reads and writes the (user, period) rows for the caller it
# authenticated and takes no target user from anything the caller sends. The two admin
# routes are the deliberate exception: they name a target user on purpose, and only after
# requireBridgeSession AND requireBridgeAdmin have both passed.
# NCB's RLS on these four tables is currently
# shared_readwrite — there is no server-only access path and no guaranteed per-user row
# isolation, so another authenticated session in the same instance can reach the same rows.
# This is a known, accepted deployment limitation, not a security control, and must not be
# described as server-only storage or as row-level security isolation. Narrowing it is
# NCB-side work.
#
#   AI_QUOTA_CONFIG_TABLE=ai_quota_config             single row: quota_enabled,
#                                                     default_call_limit, period_type
#   AI_QUOTA_USER_OVERRIDE_TABLE=ai_quota_user_override  per user: enabled, call_limit
#   AI_QUOTA_USAGE_TABLE=ai_quota_usage               per (user, period): calls_used
#   AI_QUOTA_RESERVATION_TABLE=ai_quota_reservation  per (user, period, decision key)
#
# Missing, duplicated, malformed or unaddressable rows fail CLOSED: /ai/quota and the
# config routes answer 503, /ai/chat answers 429 or 503, and the provider is not
# contacted. Nothing is ever defaulted to "unlimited" and a limit is never inferred.
#
# SINGLE REPLICATION REQUIRED. NCB exposes no atomic increment and no conditional
# arithmetic — the counter is read-check-write (read calls_used, compute +1 here, PUT the
# absolute value) with no compare-and-swap and no unique index that a second writer could
# collide with. Two replicas of this service can therefore end a 5-then-1 sequence at 5, 6
# or 7. Deploy exactly one; GET / and GET /health report `quota.replicas`. Multi-replica
# quota counting is unsupported, and this is a deployment constraint the code cannot
# enforce, which is why it is printed at startup rather than left as a comment here.
#
# Idempotency: one logical AI decision costs at most one call. The caller may send
#   x-ai-decision-key: <logical decision key>
# on POST /ai/chat. It is a BILLING label and nothing more: never authentication, never
# identity, never an owner assertion. The user it is charged to comes only from the
# validated session bearer, and the key is scoped to that user and the current UTC period,
# so a key cannot cross accounts and a reused key cannot buy a free call for a different
# user. A request without it (or with a malformed one) is charged as a new decision, and
# NodeSend never invents a key of its own. It never appears in a provider request body or
# a provider request header, and never in a log line.
#
# With the reservation table in play, deduplication is DURABLE: the claim is recorded before
# the counter moves, and withdrawn whenever the charge does not land, so a process restart
# cannot charge the same decision twice. Turning the ledger off downgrades to process-only
# memory — same rule, same limit, same answers — but a restart inside a retry window can then
# bill one decision twice, and startup says so explicitly rather than leaving it in a comment.
# Leaving the first three unset uses the defaults above. AI_QUOTA_RESERVATION_TABLE is
# different on purpose: unset also means the default table, so it has to be set EXPLICITLY
# EMPTY (AI_QUOTA_RESERVATION_TABLE=) to turn the durable ledger off. Do not do that in
# production — it is the documented escape hatch, and startup says so.
AI_QUOTA_CONFIG_TABLE=ai_quota_config
AI_QUOTA_USER_OVERRIDE_TABLE=ai_quota_user_override
AI_QUOTA_USAGE_TABLE=ai_quota_usage
AI_QUOTA_RESERVATION_TABLE=ai_quota_reservation

# --- optional --------------------------------------------------------------
PORT=3001
# Reject legacy plaintext provider keys by leaving this false (the default).
ALLOW_PLAINTEXT_AI_KEYS=false
# Upstream provider timeout, and the NCB timeout for EVERY NCB call: the session lookup
# and the quota reads and writes alike.
NODESEND_UPSTREAM_TIMEOUT_MS=90000
NODESEND_NCB_TIMEOUT_MS=8000
# Comma-separated Alibaba hosts allowed for the relay to talk to.
ALIBABA_ALLOWED_HOSTS=

# --- invitation codes and per-user provider credentials ----------------------
# Both are table NAMES, not secrets, and both default to the tables that exist in NCB
# today. They are configurable only so a rename is a configuration change rather than a
# code change.
#
# USER_CODES_TABLE is read by POST /auth/validate-invitation through NCB's PUBLIC data
# route, with no credential of any kind, because validation happens before anybody has a
# session. That is only possible while the table keeps its `public_read` policy, which is
# measured as its live state. Routing the check here therefore reduces what BRIDGEMIND's
# own browser receives — the page now gets one boolean instead of a row containing
# `secret_key` — and it does NOT make the table private: any caller that can reach the
# proxy can still read it directly. Removing `public_read` needs a privileged server
# credential this relay deliberately does not hold, so do not treat the route as the
# thing that closed the exposure. It is the precondition, not the fix.
#
# AI_CREDENTIALS_TABLE holds each account's OWN provider key as RSA-OAEP ciphertext,
# produced in the browser with /crypto/public-key. The relay reads it to make provider
# calls and hands the client metadata only; the plaintext key is never stored and never
# returned. Unlike the two tables above, this one is owned row-by-row by the very session
# that presents it, so it is the only one where NCB's `private` policy would keep working
# for the relay — which is why tightening it later is a real recommendation.
USER_CODES_TABLE=user_codes
AI_CREDENTIALS_TABLE=ai_provider_credentials_1770000000
# Abuse control for the anonymous pre-registration route: INVITATION_RATE_MAX attempts per
# address per window, then 429 with Retry-After. Per-process only — it does not survive a
# restart and is not shared between replicas, so it slows a caller down; it is not a
# distributed throttle and not access control.
INVITATION_RATE_WINDOW_MS=60000
INVITATION_RATE_MAX=20

# --- separate, unrelated server-account surface ----------------------------
# Rocket.Chat webhook, SMTP is supplied per request, and the optional generic
# /quota adapter for a trusted server-account service. None of these is the
# per-user AI quota: NODESEND_QUOTA_URL has nothing to do with whether per-user
# quota works, and the per-user authority above needs no URL of its own.
# NODESEND_QUOTA_TIMEOUT_MS is the timeout of this generic server-account adapter only;
# the per-user quota path is governed by NODESEND_NCB_TIMEOUT_MS above.
ROCKETCHAT_WEBHOOK_URL=
NODESEND_QUOTA_URL=
NODESEND_QUOTA_BEARER_TOKEN=
NODESEND_QUOTA_TIMEOUT_MS=5000

# --- TRICKSTER decision-engine gateway (server-side only) -------------------
# BridgeMind's frontend is a static Vite build, and the two TRICKSTER services send
# no CORS headers and answer a preflight with 405, so the browser cannot reach them
# directly. NodeSend exposes /trickster/{bid,play}/health and
# /trickster/{bid,play}/suggest-{bid,card}, guarded by the same BridgeMind Bearer
# session as /ai/chat (never by BRIDGE_API_KEY), forwarding the JSON body unchanged
# and preserving the upstream status. No bid or card is decided here and there is no
# AI fallback. Defaults are the production hosts, so this block can be left unset.
# Never give any of these a VITE_* prefix: a VITE_ value ships to every visitor.
TRICKSTER_BID_URL=https://bid.bridgemind.app
TRICKSTER_PLAY_URL=https://play.bridgemind.app
# Per-request upstream timeout in ms, bounded to 500-60000 (default 15000).
TRICKSTER_TIMEOUT_MS=15000
# RESERVED, not wired by the services yet. When TRICKSTER gains authentication this
# is the only place it is read; it is sent server-to-server as `x-api-key` and is
# never echoed in a response, a log line or a browser-visible variable. Leave empty.
TRICKSTER_API_KEY=

# --- CLUBS (server-side only; every name below is a secret or a deployment fact) --
# Clubs is the one feature that authenticates the CALLER and then acts as a DIFFERENT
# NCB identity. The caller's own Bearer session decides who is asking; a dedicated
# ordinary NCB account performs the club reads and writes. That split is the point:
# NCB runtime access is RLS `shared_readwrite`, so an authority read done with the
# caller's own token is a read of rows the caller can rewrite. Without this account the
# club routes do not fall back to the caller's bearer -- they answer 503 after
# authentication and body validation.
#
# The account is an ordinary NCB user, signed in over the same /auth/sign-in/email +
# /auth/get-session protocol the app already uses. No MCP secret_key, no new grant, and
# the token never leaves this process: not in a response, not in a log line, not exported.
CLUB_NCB_EMAIL=
CLUB_NCB_PASSWORD=
# Optional and preferred when known: the club account's NCB user id. With it, identity is
# confirmed by id rather than by email. If get-session answers a DIFFERENT account than
# this one (or the configured email), every club request fails closed with 503 -- a token
# that was accepted but is not provably this account's is never used to read club rows.
CLUB_NCB_EXPECTED_USER_ID=

# THE AGREED FIVE-TABLE SCHEMA. These tables DO NOT EXIST YET; they are created through
# NCB MCP by the owner after implementation review. Nothing here creates or alters a
# table, and NodeSend defaults NO table name: a guessed name does not fail loudly, it
# writes real rows into whatever table happens to answer. Until the schema is supplied,
# every club route answers a controlled 503 (`club_store_unavailable`), which the client
# renders as "the club tables do not exist yet" -- the truth, not an empty success.
#
# Provide it as inline JSON (CLUB_NCB_SCHEMA_JSON) or as a file path
# (CLUB_NCB_SCHEMA_FILE) -- exactly one. A partial schema is REFUSED at boot with the
# missing roles named, and no half-configured store is built to guess at the rest.
#
# The shape, spelled with the LIVE NCB column names (verified 2026-11-17 against the tables Greta
# created). Column keys below are stable ROLE names used by the store code; their VALUES are the real
# columns, so a rename in NCB is a config edit and never an authorization change.
#
# NOTE the three places the live schema differs from the original design, all handled here rather
# than in a rule: `clubs.active` is a numeric flag (translated by the `values` block), the
# collection's human name is `title`, and its draft/published state is `publication_status`.
#
# {
#   "tables": {
#     "systemAdmins": "system_admins",
#     "clubs": "clubs",
#     "memberships": "club_memberships",
#     "collections": "club_board_collections",
#     "boards": "club_collection_boards",
#     "users": "user_settings"
#   },
#   "columns": {
#     "systemAdmins": { "userId": "user_id" },
#     "clubs":        { "id": "id", "name": "name", "status": "active" },
#     "memberships":  { "id": "id", "userId": "user_id", "clubId": "club_id",
#                       "role": "role", "status": "status" },
#     "collections":  { "id": "id", "clubId": "club_id", "name": "title",
#                       "status": "publication_status", "createdBy": "created_by_user_id" },
#     "boards":       { "id": "id", "collectionId": "collection_id",
#                       "boardNumber": "board_number", "dealer": "dealer",
#                       "vulnerability": "vulnerability", "handsJson": "hands_json" },
#     "users":        { "userId": "user_id", "nickname": "nickname",
#                       "displayName": "display_name",
#                       "nicknameNormalized": "nickname_normalized" }
#   },
#   "values": { "clubs": { "status": { "active": 1, "inactive": 0 } } }
# }
#
# THE `users` ROLE IS OPTIONAL AND IS NOT A SIXTH CLUB TABLE — it is the only table Clubs READS but
# never writes, and it names the application's existing account-profile table so a Super Admin can
# appoint someone by typing the name they chose instead of pasting a technical NCB user id. Absent is
# a valid steady state: `GET /clubs/users` then answers 503 `club_directory_unconfigured` (never an
# empty result set, because "there is nothing to search" and "nobody matched" are different claims)
# and the member list keeps working with `display_name`/`nickname` as `null`.
#
# WHY ACCOUNT SEARCH IS A SCAN AND NOT A QUERY. Measured against the live proxy on 2026-11-18: the
# data read route accepts exact-match column equality plus `limit`, `page`, `sort` and `order`, and
# NOTHING else — `?search=`, `?q=`, `?like=` and `?offset=` each answer HTTP 500 "Unknown column …
# in 'where clause'", and a wildcard value (`code=*bc*`) simply matches nothing. So a partial name
# match cannot be pushed down: NodeSend reads at most `CLUB_NCB_ROW_LIMIT` directory rows, sorted by
# the identity column so the window is deterministic, and makes the case-insensitive comparison here.
# A search that could not look at the whole table says `truncated: true` instead of reporting nobody
# matched.
#
# EMAIL SEARCH IS NOT SUPPORTED, AND SAYING SO IS THE POINT. The profile table has no email column,
# and the table that does hold emails (`ncba_user`) is not reachable through the data route at all:
# NCB's own routing injects a user_id filter on that system table, so any read of it fails. A query
# containing "@" is therefore refused with 400 `email_lookup_unavailable` rather than answered with
# an empty list, which would tell an admin that a real person does not exist. Closing this needs an
# NCB-side capability, not a NodeSend change.
#
# A search returns `user_id`, `nickname` and `display_name` and nothing else. `avatar_url`,
# `ai_source` and every other column of that table are not read, because a name lookup that also
# hands back an AI-provider waiver is an identity dump.
#
# The `values.clubs.status` block is REQUIRED for this deployment: NCB stores the club's activity as
# numeric 1/0 while every rule, response and error name in NodeSend speaks 'active'/'inactive'. The
# translation happens at the storage boundary only. Declaring the block half-filled (say `active`
# without `inactive`) is refused at boot, because the missing half would write literal text into a
# numeric column. Omit the block entirely only if the column really does hold the text values.
#
# `clubs.status` above maps to the ROLE name `status`, whose live column is `active` -- the role name
# stays `status` so no authorization rule had to change when the column turned out to be numeric.
#
# `board_number` is VARCHAR(10): a longer number is refused with `invalid_board_record` rather than
# sent to NCB. `hands_json` is TEXT and holds exactly the four-seat deal object.
#
# `club_collection_boards.tags_json` exists in NCB but is deliberately NOT referenced by NodeSend:
# it has no agreed meaning in this feature, and reading or writing a column nobody specified is how
# two applications start disagreeing about the same row. `source_pbn` does NOT exist and is never
# written; the board the player receives is fully described by its four hands, dealer and
# vulnerability.
#
# `created_by_user_id` on a collection IS required by NCB and is always the verified caller id this
# relay resolved from the session -- never a body field, and never sent empty.
#
# `club_memberships` MUST carry UNIQUE(user_id) -- one row per USER, not one row per
# (user, club). That index is the storage half of "one club or none": with the other
# spelling a player can hold several clubs and every read that decides "their club"
# becomes a guess. `system_admins` is REQUIRED, not optional: it is the only super-admin
# authority here. A session's NCB `role` string is never one, because a value living in
# rewritable application data cannot be what unlocks club-wide power.
#
# `club_memberships.status` is REQUIRED and is what makes a membership a decision rather than an
# accident of a row existing. A user is an active club member ONLY when status = 'approved' AND their
# club is active. These five cases are one case to the server and must be indistinguishable to every
# endpoint: no club selected / pending / rejected / removed / club inactive. Each behaves exactly like
# "None" -- full ordinary BridgeMind access, zero club access -- because the row is collapsed to
# "no membership" at a single point before any rule reads it, and because nothing outside /clubs and
# /me/consults a membership at all. Club approval therefore cannot restrict ordinary play, cannot
# disable an account, and cannot block a login; it only opens club features.
#
# Lifecycle: a user's own selection creates 'pending'. A super admin or an approved admin of THAT
# club moves it to 'approved' or 'rejected' via POST /clubs/:clubId/members/:userId/status; an
# existing member is revoked with 'removed' (a status, so Profile can still explain what happened).
# Deleting the row is the voluntary-leave path. 'pending' is never imposed on someone else.
# A pending or rejected user may re-choose a club: the single UNIQUE(user_id) row is re-targeted
# rather than refused, because a user with no row at all can choose one and they must not have less.
#
# `boards.sourcePbn` is optional (it keeps the verbatim PBN deal for review); every other
# column above is required. Exactly these five table roles are accepted -- declaring a sixth
# (for example an attempts table) is REFUSED at boot rather than ignored, because board-start
# writes nothing: it authenticates, checks club membership and published state, reads the one
# board, re-validates it and returns it. Game recording belongs to BridgeMind's existing
# gameplay and recorded-hands layer, not to a second store of the same attempt.
#
# Leaving both names unset is the CORRECT state for a deployment that has not created the
# tables. Do not fill them in with plausible-looking names to make a screen happy.
# CLUB_NCB_SCHEMA_JSON=
# CLUB_NCB_SCHEMA_FILE=
#
# Optional cap on rows returned by one club list read (default 500, max 1000).
# CLUB_NCB_ROW_LIMIT=500
#
# --- ONE-TIME SUPER-ADMIN BOOTSTRAP (temporary; unset is the correct steady state) ---
# system_admins is the only Super Admin authority, so an empty table means nobody can add the
# first row. This variable opens exactly one narrow first-run path.
#
# Leave it EMPTY (or remove it) unless you are performing the one-time activation.
CLUB_BOOTSTRAP_SUPER_ADMIN_USER_ID=
#
# While unset, POST /clubs/bootstrap/super-admin answers 503 club_bootstrap_disabled. Nothing is
# granted and nothing is read.
#
# While set, the endpoint grants THAT id and no other:
#   * the caller must present a real validated BridgeMind NCB session, and that session's verified
#     user id must EQUAL this value -- the granted id is never taken from the request. The endpoint
#     accepts no body field and no query parameter at all; sending one is a 400, so there is no
#     parameter to forge.
#   * it reads system_admins first and runs ONLY if that table is EMPTY. An unreadable table is a
#     503 with nothing written -- it is never assumed empty.
#   * once any row exists it refuses everyone, including the configured id, forever after. It can
#     therefore never add to, override or displace an existing authority.
#   * the insert is made by the dedicated club account and confirmed by reading the row back; the
#     endpoint requires exactly one resulting row and reports bootstrap_unverified otherwise.
#
# ACTIVATION (run in this order):
#   1. Find your own NCB user id while logged in to BridgeMind: open DevTools -> Network -> reload
#      the app -> click the `get-session` request -> Response -> data.user.id. That is your verified
#      id; no token needs to be copied, typed or shared.
#   2. Set CLUB_BOOTSTRAP_SUPER_ADMIN_USER_ID to that id in Coolify and let the container restart.
#      (/health -> clubs.bootstrapEnabled becomes true.)
#   3. From that same logged-in browser session, POST to https://nodesend.waveloc.com/clubs/bootstrap/super-admin
#      with an empty body. Expect 200 {"status":"success","data":{"bootstrapped":true,...}}.
#      If you get 403 bootstrap_caller_mismatch, the response carries your own verified id in
#      `own_user_id` -- set the variable to that value and repeat step 3.
#   4. Confirm: GET /clubs with your session now returns 200 instead of 403 super_admin_required.
#   5. CLEANUP -- remove the variable's value in Coolify and redeploy, so the endpoint returns to
#      503 club_bootstrap_disabled. Do this even though step above already closed the grant: defence
#      in depth costs one edit, and it means /health never advertises an open bootstrap window.
#      After cleanup, /health -> clubs.bootstrapEnabled is false and the endpoint is permanently
#      inert for this table's lifetime regardless of the variable, because system_admins is no
#      longer empty.
#
# This grants nothing to anyone whose session is not already the configured NCB account, and it is
# the only place in NodeSend that writes system_admins.
#
# NEVER prefix any of the above with a VITE_ name. Vite inlines every VITE_* value into the
# published browser bundle, so a VITE_ name for the club password IS a published password. The
# club modules refuse to start on that configuration rather than shipping it quietly.

# --- PLAYER GATEWAY (/ncb) — the browser's own auth and data surface ---------
# The relay mints and validates the session a browser holds, and is the only NCB path a player
# takes. Five auth routes (sign-in, sign-up, get-session, sign-out, change-password), seven data
# routes (read, create, update, delete, with row ids where they apply), one identity echo
# (/ncb/whoami) and one restricted anonymous read (/ncb/public-data/read/user_codes).
#
# THE HANDLE, AND WHY IT IS NOT A SESSION TABLE. NodeSend owns no durable storage, so a server-side
# session map would lose every signed-in player on each container restart. The upstream NCB cookie is
# therefore sealed INTO the credential the browser already carries: AES-256-GCM, key derived by HKDF
# from NCB_SESSION_SEAL_KEY, prefix `ncbs1.`, integrity-checked and time-bounded. A restart re-opens
# the same handle with the same key, a tampered one fails the tag, and the vendor cookie itself never
# reaches a browser, a log line or a response body.
#
# REQUIRED, minimum 32 characters, and NOT optional: with it unset the gateway mounts but every
# route answers 503 `gateway_unconfigured`, and boot says so in one line. That fail-closed default is
# deliberate — a built-in key would mint handles anybody could forge after a deploy that forgot the
# variable, and every test would still pass. Rotating it invalidates every live handle at once, which
# signs everyone out; do it deliberately, not as part of a routine secret rotation.
NCB_SESSION_SEAL_KEY=
# Handle lifetime in ms. Default 12 hours, clamped to 5 minutes - 24 hours: longer than that is a
# bigger risk in localStorage, shorter logs people out mid-session.
NCB_SESSION_TTL_MS=43200000
# The ONLY origins the gateway will serve cross-origin, comma-separated, exact matches. https
# anywhere, plus http for localhost / 127.0.0.1 / [::1] with an optional port, so a development
# build on Vite's default http://localhost:5173 works. There is no wildcard and no reflection: an
# origin that is not on this list receives NO CORS header and a 403 from the route.
# EMPTY IS A VALID, SAFE STATE — it refuses every browser origin, which means a deployment that
# forgets it sees "origin_not_allowed" rather than an open gateway. List every frontend origin the
# app is served from (app., live., bid., play. for BridgeMind).
NCB_GATEWAY_ALLOWED_ORIGINS=
# Tables the browser may reach through /ncb/data/*. Unset means the built-in list, which is derived
# from the shipped app's own call sites. SETTING THIS REPLACES the default rather than adding to it,
# so it is the way to narrow a deployment, not the way to remember a table. It is always narrowed by
# two hard exclusions in code that no configuration can re-open:
#   * the club authority tables (clubs, club_memberships, club_board_collections,
#     club_collection_boards, system_admins) — those belong to the service-account path above, which
#     has its own authorization rules, and a browser-held handle must not be a second, weaker door;
#   * the quota ledger and the per-user credential store (ai_quota_config, ai_quota_user_override,
#     ai_quota_usage, ai_quota_reservation, ai_provider_credentials_1770000000) plus
#     system_ai_credentials — the first group the app never calls, and the last one holds the SYSTEM
#     AI provider key material. Reading it cross-account hands over ciphertext and a target; writing
#     it lets any signed-in account point the deployment's AI traffic at a key of its choosing.
#
# DO NOT READ EITHER POLICY AS AN ISOLATION GUARANTEE. They decide which tables and verbs the RELAY
# forwards; they do not decide which rows NCB hands back. `user_settings` and `llm_preferences` are
# `shared_readwrite` — measured 2026-11-17, and corroborated by the frontend itself, which filters
# every one of those reads by `user_id` (settingsService.js:191, :211) rather than relying on the
# database to do it. So any signed-in player can read another account's rows in those two tables
# through the gateway, exactly as they could through the old Lambda. Per-user row isolation has only
# ever been demonstrated on a table declared private (the scratch table the native RLS test proved).
# Saying "the gateway enforces RLS" would be false; narrowing these tables is NCB-side policy work.
#
# THE ALLOW-LIST ANSWERS *which tables*. A SECOND POLICY ANSWERS *which verbs*, and it is not
# configurable, because a table the player merely reads must not be a table the player can rewrite:
#   full   (read/create/update/delete) — the player's own data: user_settings, llm_preferences,
#            recorded_hands, community_games, replay_attempts, game_analysis_reports, tournaments,
#            tournament_boards, tournament_attempts
#   create (read/create only)          — the player appends about their own play: coach_feedback_flags,
#            ai_usage_events, ai_decision_traces
#   read   (reads only)                — app_config, ai_providers, ai_models, ai_model_parameters,
#            system_ai_config, user_codes. Any table not deliberately listed lands here.
# A write outside its policy is refused with 403 write_not_allowed BEFORE the credential is parsed, so
# no upstream call is made and the caller learns the real reason.
#
# CONSEQUENCE FOR REGISTRATION, stated because it is deliberate and easy to miss: BridgeMind's signup
# claims its invitation code by PUT-ing the user_codes row (Login.jsx claimInvitationCode). user_codes
# is read-only through the gateway, so that claim is refused. The order in the shipped frontend matters
# here: sign-up happens FIRST and the claim is what follows, so with the claim refused a code is never
# marked used while an account already exists — registration simultaneously open and broken. The
# gateway therefore refuses POST /ncb/auth/sign-up/email outright (403 sign_up_unavailable, before any
# upstream call), which makes **public registration unavailable on this build** as a fact in the code
# rather than as a sentence in a release note. Signing in is untouched. Registration resumes when the
# claim moves to the server-side route that authorizes it
# (POST /auth/consume-invitation), which must first be corrected to record registered_user_id — today
# it writes user_id, a session-assigned column NCB silently drops on update.
#
# The lever is this variable, and it is exact on purpose: only `1` opens registration. `true`, `yes`,
# `on` and an empty value all leave it closed, because a mistyped value that silently opened a public
# signup endpoint would be invisible until someone used it. /health reports the resulting state as
# ncbGateway.signUpAllowed, and verify-ncb-gateway.mjs section 16 measures both directions.
# NCB_TABLE_ALLOWLIST=
# Credential-stuffing throttle on /ncb/auth/*, per address per window. The same shape as the
# invitation limiter above: in-process, per replica, throttling rather than access control.
NCB_GATEWAY_AUTH_RATE_MAX=20
NCB_GATEWAY_AUTH_RATE_WINDOW_MS=60000
# The anonymous invitation-code read is an existence oracle before any session exists, so it is
# throttled tighter than sign-in (default 10 per window). One table, one equality filter on `code` or
# `id`, and four projected fields — an unfiltered request is a 400, never a list.
NCB_GATEWAY_PUBLIC_RATE_MAX=10
# Public account creation, through the gateway, is CLOSED unless this is exactly `1`. See the
# registration paragraph above: until invitation claiming is moved server-side, an open signup endpoint
# hands out accounts that no code authorises. Set to 1 only when that claiming is verified.
NCB_GATEWAY_ALLOW_SIGN_UP=0

# DEPLOYMENT ORDER, because the last Clubs outage was caused by doing this backwards:
#   1. Deploy the CODE first, with NCB_TRANSPORT left at `proxy`. Nothing changes for anyone; the
#      gateway is mounted but the app is not pointed at it yet.
#   2. Set NCB_SESSION_SEAL_KEY and NCB_GATEWAY_ALLOWED_ORIGINS, and confirm /health shows
#      ncbGateway.configured true with the expected origin and table counts, and
#      ncbGateway.signUpAllowed false unless claiming has been verified.
#   3. Set NCB_TRANSPORT=native. The relay now refuses any non-sealed bearer instead of dialling the
#      dead proxy, so this is the step that changes live behaviour.
#   4. Rebuild and publish BridgeMind so its gateway base points at this relay's /ncb mount. The
#      variable is named in the frontend repository's own template; it is deliberately not repeated
#      here, because a VITE_* name in THIS file would be a frontend variable living in the file that
#      holds server secrets, and one of the release gates refuses that pattern on purpose.
#      Order matters: the frontend must not hold sealed handles while the relay is still in proxy
#      mode, and the relay must not be in native mode while the frontend still sends old tokens.
#      Players who are signed in at step 3 are asked to sign in again, which is the honest answer to
#      a credential the relay cannot verify — it is not an outage, and it heals on that sign-in.
#   5. Confirm /health and one end-to-end sign-in before closing the incident.
#
# NCB_ALLOW_INSECURE_UPSTREAM=1 is a TEST-ONLY escape that lets the transport dial a loopback http
# fake. It has no effect on a non-loopback URL and must never be set in production.
