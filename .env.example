# NodeSend relay — required and optional environment.
# Values are never committed. In the hosted deployment these live in Coolify.
# Nothing here may be exposed to the browser: no VITE_* prefix, ever.

# --- mandatory -------------------------------------------------------------
# Shared relay key for the server-to-server surfaces only: /send, /rocketchat,
# and the generic /quota adapter. AI endpoints are authenticated by the signed-in
# BridgeMind session instead, so this key is not what guards the AI path.
BRIDGE_API_KEY=

# RSA private key used to decrypt provider API keys that arrive from the browser
# as RSA-OAEP/SHA-256 ciphertext. Base64 of the PEM, or the PEM itself with
# literal \n separators. Exactly one of the two is set.
NODESEND_PRIVATE_KEY_B64=
NODESEND_PRIVATE_KEY_PEM=

# --- session authority AND quota storage (defaults match the BridgeMind instance) --
# NCB is the application database owner and is used here for two things:
#   /auth/get-session        to prove WHO the caller is and what role they hold
#   /data/{read,create,update,delete}/<table>   the per-user AI quota counter
# Both go through the SAME call and the SAME credential: the caller's own session bearer.
# There is no quota service URL to configure, no quota service secret, and no second
# backend hop — NodeSend is the only quota backend and BridgeMind is a static frontend
# that talks to these routes. Never give any of these a VITE_* prefix: a VITE_ value
# ships to every visitor.
NCB_PROXY_BASE=https://rmvzorxcl35mttidiexhtp5g2m0hpsqo.lambda-url.us-east-2.on.aws
NCB_INSTANCE=55954_bridgemind

# --- per-user AI quota AUTHORITY (decided here; stored in NCB; never a browser value) --
# NodeSend resolves the configuration, the per-user limit and the usage row, keeps the
# period arithmetic, holds the reservation ledger, and writes the counter itself — reading
# and writing these four NCB tables with the caller's bearer. Routes:
#   POST /ai/chat            reserves one call BEFORE the provider is contacted
#   GET  /ai/quota           the caller's current summary, no spend
#   GET  /ai/quota/config    admin-only configuration read  (session + admin role)
#   PUT  /ai/quota/config    admin-only configuration write (session + admin role)
#   GET  /ai/quota/status    admin-only view of one TARGET user's quota (session + admin)
#   PUT  /ai/quota/user      admin-only per-user limit write   (session + admin role)
# Defaults match the tables that exist in NCB today; the names are configurable only so a
# rename is not a code change. Table names are not secrets. Every quota read and write is
# made with the caller's own validated session bearer: that proves the identity the quota
# decision is taken for, and nothing more. Normal quota operations are addressed by that
# validated user id — NodeSend reads and writes the (user, period) rows for the caller it
# authenticated and takes no target user from anything the caller sends. The two admin
# routes are the deliberate exception: they name a target user on purpose, and only after
# requireBridgeSession AND requireBridgeAdmin have both passed.
# NCB's RLS on these four tables is currently
# shared_readwrite — there is no server-only access path and no guaranteed per-user row
# isolation, so another authenticated session in the same instance can reach the same rows.
# This is a known, accepted deployment limitation, not a security control, and must not be
# described as server-only storage or as row-level security isolation. Narrowing it is
# NCB-side work.
#
#   AI_QUOTA_CONFIG_TABLE=ai_quota_config             single row: quota_enabled,
#                                                     default_call_limit, period_type
#   AI_QUOTA_USER_OVERRIDE_TABLE=ai_quota_user_override  per user: enabled, call_limit
#   AI_QUOTA_USAGE_TABLE=ai_quota_usage               per (user, period): calls_used
#   AI_QUOTA_RESERVATION_TABLE=ai_quota_reservation  per (user, period, decision key)
#
# Missing, duplicated, malformed or unaddressable rows fail CLOSED: /ai/quota and the
# config routes answer 503, /ai/chat answers 429 or 503, and the provider is not
# contacted. Nothing is ever defaulted to "unlimited" and a limit is never inferred.
#
# SINGLE REPLICATION REQUIRED. NCB exposes no atomic increment and no conditional
# arithmetic — the counter is read-check-write (read calls_used, compute +1 here, PUT the
# absolute value) with no compare-and-swap and no unique index that a second writer could
# collide with. Two replicas of this service can therefore end a 5-then-1 sequence at 5, 6
# or 7. Deploy exactly one; GET / and GET /health report `quota.replicas`. Multi-replica
# quota counting is unsupported, and this is a deployment constraint the code cannot
# enforce, which is why it is printed at startup rather than left as a comment here.
#
# Idempotency: one logical AI decision costs at most one call. The caller may send
#   x-ai-decision-key: <logical decision key>
# on POST /ai/chat. It is a BILLING label and nothing more: never authentication, never
# identity, never an owner assertion. The user it is charged to comes only from the
# validated session bearer, and the key is scoped to that user and the current UTC period,
# so a key cannot cross accounts and a reused key cannot buy a free call for a different
# user. A request without it (or with a malformed one) is charged as a new decision, and
# NodeSend never invents a key of its own. It never appears in a provider request body or
# a provider request header, and never in a log line.
#
# With the reservation table in play, deduplication is DURABLE: the claim is recorded before
# the counter moves, and withdrawn whenever the charge does not land, so a process restart
# cannot charge the same decision twice. Turning the ledger off downgrades to process-only
# memory — same rule, same limit, same answers — but a restart inside a retry window can then
# bill one decision twice, and startup says so explicitly rather than leaving it in a comment.
# Leaving the first three unset uses the defaults above. AI_QUOTA_RESERVATION_TABLE is
# different on purpose: unset also means the default table, so it has to be set EXPLICITLY
# EMPTY (AI_QUOTA_RESERVATION_TABLE=) to turn the durable ledger off. Do not do that in
# production — it is the documented escape hatch, and startup says so.
AI_QUOTA_CONFIG_TABLE=ai_quota_config
AI_QUOTA_USER_OVERRIDE_TABLE=ai_quota_user_override
AI_QUOTA_USAGE_TABLE=ai_quota_usage
AI_QUOTA_RESERVATION_TABLE=ai_quota_reservation

# --- optional --------------------------------------------------------------
PORT=3001
# Reject legacy plaintext provider keys by leaving this false (the default).
ALLOW_PLAINTEXT_AI_KEYS=false
# Upstream provider timeout, and the NCB timeout for EVERY NCB call: the session lookup
# and the quota reads and writes alike.
NODESEND_UPSTREAM_TIMEOUT_MS=90000
NODESEND_NCB_TIMEOUT_MS=8000
# Comma-separated Alibaba hosts allowed for the relay to talk to.
ALIBABA_ALLOWED_HOSTS=

# --- separate, unrelated server-account surface ----------------------------
# Rocket.Chat webhook, SMTP is supplied per request, and the optional generic
# /quota adapter for a trusted server-account service. None of these is the
# per-user AI quota: NODESEND_QUOTA_URL has nothing to do with whether per-user
# quota works, and the per-user authority above needs no URL of its own.
# NODESEND_QUOTA_TIMEOUT_MS is the timeout of this generic server-account adapter only;
# the per-user quota path is governed by NODESEND_NCB_TIMEOUT_MS above.
ROCKETCHAT_WEBHOOK_URL=
NODESEND_QUOTA_URL=
NODESEND_QUOTA_BEARER_TOKEN=
NODESEND_QUOTA_TIMEOUT_MS=5000

# --- TRICKSTER decision-engine gateway (server-side only) -------------------
# BridgeMind's frontend is a static Vite build, and the two TRICKSTER services send
# no CORS headers and answer a preflight with 405, so the browser cannot reach them
# directly. NodeSend exposes /trickster/{bid,play}/health and
# /trickster/{bid,play}/suggest-{bid,card}, guarded by the same BridgeMind Bearer
# session as /ai/chat (never by BRIDGE_API_KEY), forwarding the JSON body unchanged
# and preserving the upstream status. No bid or card is decided here and there is no
# AI fallback. Defaults are the production hosts, so this block can be left unset.
# Never give any of these a VITE_* prefix: a VITE_ value ships to every visitor.
TRICKSTER_BID_URL=https://bid.bridgemind.app
TRICKSTER_PLAY_URL=https://play.bridgemind.app
# Per-request upstream timeout in ms, bounded to 500-60000 (default 15000).
TRICKSTER_TIMEOUT_MS=15000
# RESERVED, not wired by the services yet. When TRICKSTER gains authentication this
# is the only place it is read; it is sent server-to-server as `x-api-key` and is
# never echoed in a response, a log line or a browser-visible variable. Leave empty.
TRICKSTER_API_KEY=
